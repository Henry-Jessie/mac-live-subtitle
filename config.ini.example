[translation]
; Translation LLM API endpoint (OpenAI-compatible)
base_url = https://api.deepseek.com/v1
; Environment variable name that holds the API key (default: OPENAI_API_KEY)
api_key_env = DEEPSEEK_API_KEY
model = deepseek-v4-flash
; DeepSeek V4 thinking mode: false = disabled (default, lower latency & cost),
; true = enabled (reasoning), auto = omit the parameter (server decides).
; DeepSeek-specific — set to auto for other providers if they reject the field.
thinking = false
target_lang = Simplified Chinese
; Enable translation (true/false). When false, only segmented source text is shown.
enabled = true
; LLM sampling temperature (default: 1.0)
temperature = 1.0
; Extra JSON body merged into LLM API calls, e.g. {"thinking": {"type": "disabled"}}
; (the dedicated `thinking` option above takes precedence over a thinking key here)
; extra_body =
; Enable debug logging for translation requests
; debug = false

[transcription]
; ASR backend (funasr_realtime is currently the only supported backend)
backend = funasr_realtime
; Source language hint (auto = auto-detect; for funasr maps to language_hints, e.g. zh, en, ja)
source_language = auto

; --- FunASR Realtime settings (DashScope Recognition API) ---
funasr_realtime_model = fun-asr-realtime
; Standard: wss://dashscope.aliyuncs.com/api-ws/v1/inference
; Workspace-specific: wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/inference
; Beijing and Singapore API keys are region-specific and not interchangeable
funasr_realtime_ws_url = wss://dashscope.aliyuncs.com/api-ws/v1/inference
; Environment variable name for the DashScope API key
funasr_realtime_api_key_env = DASHSCOPE_API_KEY
; Or set the key directly (takes precedence over env var)
; funasr_realtime_api_key =
; Semantic punctuation prediction (server-side semantic segmentation:
; more accurate sentence boundaries, longer segments, higher latency).
; When false, VAD segmentation is used (shorter segments, lower latency,
; may cut mid-sentence at pauses) and the two knobs below take effect.
funasr_realtime_semantic_punctuation = true
; VAD silence threshold in ms before a sentence is considered finished
; (200-6000, server default 1300; 0 = omit). VAD mode only.
; funasr_realtime_max_sentence_silence = 800
; Prevent VAD from producing over-long sentences. VAD mode only.
; funasr_realtime_multi_threshold = true
; Interim translations for long sentences: while a sentence is still growing,
; fire a temporary translation each time its display length crosses another
; multiple of this threshold (CJK chars count 2; 0 = disable). Temporary
; results are overwritten by later ones and never affect the translation
; context window; the final translation happens at sentence end as usual.
funasr_interim_translate_chars = 40
; Optional: append raw sentence events (interim/end with timestamps) as JSONL
; for debugging or as golden-test material
; funasr_realtime_event_log = funasr_events.jsonl

[audio]
; Audio input device index (auto = auto-detect BlackHole on macOS)
device_index = auto
sample_rate = 16000
; Audio frame step size in seconds for the streaming generator
streaming_step_size = 0.2

[display]
always_on_top = true
; Font size in px for original (source) text
original_font_size = 13
; Font size in px for translated text
translated_font_size = 17
